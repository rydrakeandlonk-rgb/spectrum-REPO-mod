<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SpectrumRepoMod</AssemblyName>
    <RootNamespace>SpectrumRepoMod</RootNamespace>
    <Version>0.3.2</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup><Compile Include="Plugin.cs" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" ExcludeAssets="runtime" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="StageVortexPackage" AfterTargets="Build">
    <PropertyGroup><PackageStage>$(MSBuildProjectDirectory)/../dist/Spectrum_REPO_Mod</PackageStage></PropertyGroup>
    <MakeDir Directories="$(PackageStage)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStage)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../manifest.json" DestinationFolder="$(PackageStage)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../README.md" DestinationFolder="$(PackageStage)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../CHANGELOG.md" DestinationFolder="$(PackageStage)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../icon.png" DestinationFolder="$(PackageStage)" />
  </Target>
</Project>
